----------------------------------------------------------------
-- LÓGICA DO AUTO BUY
----------------------------------------------------------------
local function equiparMelhorArma()
    if not autoBuyAtivado then return end
    local meuDano = localDoDano.Value
    local melhorArmaDisponivel = nil
    
    for i = #listaArmas, 1, -1 do
        if meuDano >= listaArmas[i].DanoNecessario then
            melhorArmaDisponivel = listaArmas[i].Nome
            break
        end
    end
    
    if melhorArmaDisponivel then
        RemoteEquip:FireServer(melhorArmaDisponivel)
    end
end

AutoBuyBtn.MouseButton1Click:Connect(function()
    autoBuyAtivado = not autoBuyAtivado
    if autoBuyAtivado then
        AutoBuyBtn.Text = "Auto Buy/Equip: ON"
        AutoBuyBtn.BackgroundColor3 = Color3.fromRGB(46, 117, 89)
        BtnStroke1.Color = Color3.fromRGB(70, 160, 120)
        equiparMelhorArma()
    else
        AutoBuyBtn.Text = "Auto Buy/Equip: OFF"
        AutoBuyBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
        BtnStroke1.Color = Color3.fromRGB(50, 50, 55)
    end
end)

localDoDano.Changed:Connect(function()
    if autoBuyAtivado then equiparMelhorArma() end
end)

----------------------------------------------------------------
-- LÓGICA DO WALLCHECK E FOV AIMBOT
----------------------------------------------------------------

local function estaVisivel(posicaoAlvo, characterAlvo)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Head") then return false end
    
    local origem = Camera.CFrame.Position
    local direcao = (posicaoAlvo - origem).Unit * (posicaoAlvo - origem).Magnitude
    
    local parametrosRaycast = RaycastParams.new()
    parametrosRaycast.FilterType = Enum.RaycastFilterType.Exclude
    parametrosRaycast.FilterDescendantsInstances = {LocalPlayer.Character, characterAlvo}
    parametrosRaycast.IgnoreWater = true
    
    local resultado = workspace:Raycast(origem, direcao, parametrosRaycast)
    return resultado == nil
end

local function pegarSCPMaisProximoDaMira()
    local menorDistanciaDaMira = math.huge
    local alvoSelecionado = nil
    local scpTeam = Teams:FindFirstChild("SCP")

    if not scpTeam then return nil end

    for _, jogador in ipairs(Players:GetPlayers()) do
        if jogador ~= LocalPlayer and jogador.Team == scpTeam then
            local char = jogador.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChildOfClass("Humanoid") then
                if char.Humanoid.Health > 0 then
                    local posicaoTela, visivelNaTela = Camera:WorldToViewportPoint(char.Head.Position)
                    
                    if visivelNaTela then
                        local centroTela = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                        local distanciaMira = (Vector2.new(posicaoTela.X, posicaoTela.Y) - centroTela).Magnitude
                        
                        -- CORREÇÃO DAQUI PARA BAIXO (Adicionado os traços de comentário)
                        -- Verifica se o corte por círculo está ativo e se o alvo está dentro dele
                        if raioFOV == 0 or distanciaMira <= raioFOV then
                            if distanciaMira < menorDistanciaDaMira then
                                -- Executa o Wallcheck para confirmar se não tem paredes no meio
if estaVisivel(char.Head.Position, char) then
menorDistanciaDaMira = distanciaMira
alvoSelecionated = char.Head
alvoSelecionado = char.Head
end
end
end
end
end
end
end
end
return alvoSelecionado
end
AimbotBtn.MouseButton1Click:Connect(function()
aimbotAtivado = not aimbotAtivado
if aimbotAtivado then
AimbotBtn.Text = "Aimbot (Wallcheck): ON"
AimbotBtn.BackgroundColor3 = Color3.fromRGB(46, 117, 89)
BtnStroke2.Color = Color3.fromRGB(70, 160, 120)
if raioFOV > 0 then CirculoFOV.Visible = true end
else
AimbotBtn.Text = "Aimbot (Wallcheck): OFF"
AimbotBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 38)
BtnStroke2.Color = Color3.fromRGB(50, 50, 55)
CirculoFOV.Visible = false
end
end)
FovBtn.MouseButton1Click:Connect(function()
fovIndex = fovIndex + 1
if fovIndex > #fovTamanhos then fovIndex = 1 end
raioFOV = fovTamanhos[fovIndex]
CirculoFOV.Radius = raioFOV
if raioFOV == 0 then
FovBtn.Text = "Tamanho do FOV: Desativado"
CirculoFOV.Visible = false
else
FovBtn.Text = "Tamanho do FOV: " .. raioFOV
if aimbotAtivado then CirculoFOV.Visible = true end
end
end)
RunService.RenderStepped:Connect(function()
if CirculoFOV.Visible then
CirculoFOV.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
end
if aimbotAtivado then
local apertado = UserInputService:IsMouseButtonPressed(Enum.MouseButton1) or UserInputService:IsMouseButtonPressed(Enum.MouseButton2)
if apertado then
local alvo = pegarSCPMaisProximoDaMira()
if alvo then
Camera.CFrame = CFrame.new(Camera.CFrame.Position, alvo.Position)
end
end
end
end)
